.ipynb_checkpoints/

# =========================================================
# Runtime outputs / generated artifacts
# =========================================================
# All generated data lives under the repo-root warehouse/ directory — raw
# provider payloads, normalized canonical records, curated and feature
# datasets, predictions, models, run outputs, and the cloud-spend ledger.
# Anchor with / so src/kinetic/ingestion/warehouse/ (source) is not ignored.
# See docs/architecture/data-lifecycle.md.
/warehouse/

# Pre-0.2 output locations. Still ignored so an existing checkout does not start
# proposing generated files for commit after the upgrade.
artifacts/
experiments/
data/raw/
data/processed/
data/cost/
data/cache/

# Large generated datasets
*.jsonl
# Committed offline fixtures for the semiconductor relevance benchmark.
!tests/fixtures/research/relevance_benchmark/*.jsonl
# Committed synthetic fixtures for the real-corpus relevance pilot (software tests).
!tests/fixtures/research/relevance_pilot/*.jsonl

# Rights-cleared real article corpora and local-only annotation outputs.
# Never commit private article bodies.
data/real_corpus/
data/local_only/
**/calibration_annotation_batch.csv
**/formal_annotation_batch.csv
!tests/fixtures/research/relevance_pilot/*.csv

# =========================================================
# Logs
# =========================================================
*.log

# =========================================================
# Optional local config overrides (deep-merged over the selected config at
# runtime; keep real project IDs / secrets here, never in public configs)
# =========================================================
configs/local.yaml
configs/*.local.yaml
config.local.yaml
config.local.yml
